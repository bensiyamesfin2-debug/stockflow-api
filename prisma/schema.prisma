  productId   Int       @map("product_id")
  price       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([productId])
  @@map("price_list_items")
}

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  transferNumber  String              @unique @map("transfer_number") @db.VarChar(60)
  fromLocationId  Int                 @map("from_location_id")
  toLocationId    Int                 @map("to_location_id")
  transferredById Int                 @map("transferred_by_id")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  fromLocation    InventoryLocation   @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation      InventoryLocation   @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  transferredBy   User                @relation("TransfersCreated", fields: [transferredById], references: [id], onDelete: Restrict)
  items           StockTransferItem[]

  @@index([fromLocationId, createdAt])
  @@index([toLocationId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         Int           @id @default(autoincrement())
  transferId Int           @map("transfer_id")
  productId  Int           @map("product_id")
  batchId    Int?          @map("batch_id")
