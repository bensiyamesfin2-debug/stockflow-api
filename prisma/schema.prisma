  @@map("customers")
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  orderNumber String              @unique @map("order_number") @db.VarChar(50)
  supplierId  Int                 @map("supplier_id")
  createdById Int                 @map("created_by_id")
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?           @map("expected_at") @db.Timestamptz(3)
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("PurchaseOrdersCreated", fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  receipts    StockReceipt[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int           @map("purchase_order_id")
  productId        Int           @map("product_id")
