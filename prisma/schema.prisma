generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CASHIER
  INVENTORY_STAFF
}

enum SaleStatus {
  PENDING_RELEASE
  PARTIALLY_RELEASED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum InventoryMovementType {
  STOCK_IN
  RELEASE
  RETURN_IN
  DAMAGE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  COMPLETED
  ADJUSTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model User {
  id                   Int                 @id @default(autoincrement())
  fullName             String              @map("full_name") @db.VarChar(150)
  username             String              @unique @db.VarChar(100)
  passwordHash         String              @map("password_hash")
  role                 UserRole
  isActive             Boolean             @default(true) @map("is_active")
  failedLoginAttempts  Int                 @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?           @map("locked_until") @db.Timestamptz(3)
  lastLoginAt          DateTime?           @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt    DateTime            @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  tokenVersion         Int                 @default(0) @map("token_version")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales                Sale[]              @relation("CashierSales")
  paymentsRecorded     Payment[]           @relation("RecordedPayments")
  inventoryReleases    InventoryRelease[]  @relation("ReleasedBy")
  stockReceipts        StockReceipt[]      @relation("ReceivedBy")
  inventoryMovements   InventoryMovement[] @relation("MovementCreatedBy")
  auditLogs            AuditLog[]          @relation("UserAuditLogs")
  loginPairings        LoginPairing[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  purchaseOrders       PurchaseOrder[]     @relation("PurchaseOrdersCreated")
  stockCountsCreated   StockCount[]        @relation("StockCountsCreated")
  stockCountsCompleted StockCount[]        @relation("StockCountsCompleted")
  stockCountsAdjusted  StockCount[]        @relation("StockCountsAdjusted")
  shifts               Shift[]

  @@map("users")
}

model LoginPairing {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("login_pairings")
}

model Product {
  id                 Int                 @id @default(autoincrement())
  sku                String              @unique @db.VarChar(100)
  name               String              @db.VarChar(200)
  length             Int?
  width              Int?
  thickness          Int?
  description        String?
  sellingPrice       Decimal             @map("selling_price") @db.Decimal(12, 2)
  costPrice          Decimal?            @map("cost_price") @db.Decimal(12, 2)
  categoryId         Int?                @map("category_id")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventory          Inventory?
  saleItems          SaleItem[]
  stockReceiptItems  StockReceiptItem[]
  inventoryMovements InventoryMovement[]
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]
  stockCountItems    StockCountItem[]

  @@index([categoryId])
  @@map("products")
}

model Inventory {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique @map("product_id")
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderLevel     Int      @default(5) @map("reorder_level")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model Sale {
  id                 Int                @id @default(autoincrement())
  saleNumber         String             @unique @map("sale_number") @db.VarChar(50)
  clientRequestId    String?            @unique @map("client_request_id") @db.Uuid
  cashierId          Int                @map("cashier_id")
  customerId         Int?               @map("customer_id")
  discountId         Int?               @map("discount_id")
  shiftId            Int?               @map("shift_id")
  customerName       String?            @map("customer_name") @db.VarChar(150)
  discountAmount     Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount        Decimal            @map("total_amount") @db.Decimal(12, 2)
  status             SaleStatus         @default(PENDING_RELEASE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?            @map("cancellation_reason")
  cashier            User               @relation("CashierSales", fields: [cashierId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]
  releases           InventoryRelease[]
  notifications      Notification[]
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount           Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  shift              Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([cashierId])
  @@index([customerId])
  @@index([discountId])
  @@index([shiftId])
  @@index([status, createdAt])
  @@map("sales")
}

model SaleItem {
  id                 Int                    @id @default(autoincrement())
  saleId             Int                    @map("sale_id")
  productId          Int                    @map("product_id")
  quantity           Int
  unitPrice          Decimal                @map("unit_price") @db.Decimal(12, 2)
  costPriceAtSale    Decimal?               @map("cost_price_at_sale") @db.Decimal(12, 2)
  releasedQuantity   Int                    @default(0) @map("released_quantity")
  customLength       Int?                   @map("custom_length")
  customWidth        Int?                   @map("custom_width")
  customThickness    Int?                   @map("custom_thickness")
  requestedPieces    Int?                   @map("requested_pieces")
  piecesPerStockUnit Int?                   @map("pieces_per_stock_unit")
  sale               Sale                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  releaseItems       InventoryReleaseItem[]

  @@unique([saleId, productId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id                   Int           @id @default(autoincrement())
  saleId               Int           @map("sale_id")
  paymentMethod        PaymentMethod @map("payment_method")
  status               PaymentStatus @default(COMPLETED)
  bankName             String?       @map("bank_name") @db.VarChar(150)
  transactionReference String?       @map("transaction_reference") @db.VarChar(150)
  amount               Decimal       @db.Decimal(12, 2)
  recordedById         Int           @map("recorded_by_id")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  sale                 Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  recordedBy           User          @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([paymentMethod, createdAt])
  @@map("payments")
}

model InventoryRelease {
  id            Int                    @id @default(autoincrement())
  releaseNumber String                 @unique @map("release_number") @db.VarChar(50)
  saleId        Int                    @map("sale_id")
  releasedById  Int                    @map("released_by_id")
  notes         String?
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  sale          Sale                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  releasedBy    User                   @relation("ReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  items         InventoryReleaseItem[]

  @@index([saleId])
  @@map("inventory_releases")
}

model InventoryReleaseItem {
  id         Int              @id @default(autoincrement())
  releaseId  Int              @map("release_id")
  saleItemId Int              @map("sale_item_id")
  quantity   Int
  release    InventoryRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  saleItem   SaleItem         @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@unique([releaseId, saleItemId])
  @@index([saleItemId])
  @@map("inventory_release_items")
}

model StockReceipt {
  id              Int                @id @default(autoincrement())
  receiptNumber   String             @unique @map("receipt_number") @db.VarChar(50)
  supplierName    String?            @map("supplier_name") @db.VarChar(150)
  supplierId      Int?               @map("supplier_id")
  purchaseOrderId Int?               @map("purchase_order_id")
  referenceNumber String?            @map("reference_number") @db.VarChar(150)
  receivedById    Int                @map("received_by_id")
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  receivedBy      User               @relation("ReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  items           StockReceiptItem[]
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([receivedById, createdAt])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id        Int          @id @default(autoincrement())
  receiptId Int          @map("receipt_id")
  productId Int          @map("product_id")
  quantity  Int
  unitCost  Decimal?     @map("unit_cost") @db.Decimal(12, 2)
  receipt   StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([receiptId, productId])
  @@index([productId])
  @@map("stock_receipt_items")
}

model InventoryMovement {
  id             Int                   @id @default(autoincrement())
  productId      Int                   @map("product_id")
  movementType   InventoryMovementType @map("movement_type")
  quantityChange Int                   @map("quantity_change")
  balanceAfter   Int                   @map("balance_after")
  referenceType  String                @map("reference_type") @db.VarChar(50)
  referenceId    Int?                  @map("reference_id")
  createdById    Int                   @map("created_by_id")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy      User                  @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  saleId    Int?      @map("sale_id")
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(160)
  message   String
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([saleId])
  @@map("notifications")
}

model PushSubscription {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  endpoint       String   @unique
  p256dh         String   @db.VarChar(255)
  auth           String   @db.VarChar(255)
  expirationTime BigInt?  @map("expiration_time")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model SalesLead {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name") @db.VarChar(100)
  businessName String   @map("business_name") @db.VarChar(150)
  phone        String   @db.VarChar(30)
  interest     String   @default("STOCKFLOW") @db.VarChar(50)
  city         String?  @db.VarChar(100)
  message      String?
  status       String   @default("NEW") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("sales_leads")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(120)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@map("categories")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(150)
  contactName    String?         @map("contact_name") @db.VarChar(150)
  phone          String?         @db.VarChar(40)
  email          String?         @db.VarChar(254)
  address        String?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  purchaseOrders PurchaseOrder[]
  stockReceipts  StockReceipt[]

  @@map("suppliers")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  phone     String?  @db.VarChar(40)
  email     String?  @db.VarChar(254)
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales     Sale[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  orderNumber String              @unique @map("order_number") @db.VarChar(50)
  supplierId  Int                 @map("supplier_id")
  createdById Int                 @map("created_by_id")
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?           @map("expected_at") @db.Timestamptz(3)
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("PurchaseOrdersCreated", fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  receipts    StockReceipt[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int           @map("purchase_order_id")
  productId        Int           @map("product_id")
  quantity         Int
  receivedQuantity Int           @default(0) @map("received_quantity")
  unitCost         Decimal       @map("unit_cost") @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model StockCount {
  id            Int              @id @default(autoincrement())
  countNumber   String           @unique @map("count_number") @db.VarChar(50)
  status        StockCountStatus @default(DRAFT)
  createdById   Int              @map("created_by_id")
  completedById Int?             @map("completed_by_id")
  adjustedById  Int?             @map("adjusted_by_id")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(3)
  adjustedAt    DateTime?        @map("adjusted_at") @db.Timestamptz(3)
  createdBy     User             @relation("StockCountsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy   User?            @relation("StockCountsCompleted", fields: [completedById], references: [id], onDelete: Restrict)
  adjustedBy    User?            @relation("StockCountsAdjusted", fields: [adjustedById], references: [id], onDelete: Restrict)
  items         StockCountItem[]

  @@index([status, createdAt])
  @@map("stock_counts")
}

model StockCountItem {
  id                 Int        @id @default(autoincrement())
  stockCountId       Int        @map("stock_count_id")
  productId          Int        @map("product_id")
  expectedQuantity   Int        @map("expected_quantity")
  countedQuantity    Int?       @map("counted_quantity")
  adjustmentQuantity Int?       @map("adjustment_quantity")
  stockCount         StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product            Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([productId])
  @@map("stock_count_items")
}

model Discount {
  id              Int          @id @default(autoincrement())
  code            String       @unique @db.VarChar(50)
  name            String       @db.VarChar(150)
  type            DiscountType
  value           Decimal      @db.Decimal(12, 2)
  minimumAmount   Decimal?     @map("minimum_amount") @db.Decimal(12, 2)
  maximumDiscount Decimal?     @map("maximum_discount") @db.Decimal(12, 2)
  startsAt        DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?    @map("ends_at") @db.Timestamptz(3)
  usageLimit      Int?         @map("usage_limit")
  usageCount      Int          @default(0) @map("usage_count")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales           Sale[]

  @@index([isActive, startsAt, endsAt])
  @@map("discounts")
}

model Shift {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  status       ShiftStatus @default(OPEN)
  openingCash  Decimal     @default(0) @map("opening_cash") @db.Decimal(12, 2)
  closingCash  Decimal?    @map("closing_cash") @db.Decimal(12, 2)
  expectedCash Decimal?    @map("expected_cash") @db.Decimal(12, 2)
  notes        String?
  openedAt     DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt     DateTime?   @map("closed_at") @db.Timestamptz(3)
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sales        Sale[]

  @@index([userId, status])
  @@index([openedAt])
  @@map("shifts")
}
