  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch      StockBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([batchId])
  @@map("stock_transfer_items")
}

model Quotation {
  id            Int             @id @default(autoincrement())
  quoteNumber   String          @unique @map("quote_number") @db.VarChar(60)
  customerId    Int?            @map("customer_id")
  customerName  String?         @map("customer_name") @db.VarChar(150)
  customerPhone String?         @map("customer_phone") @db.VarChar(40)
  createdById   Int             @map("created_by_id")
  status        QuotationStatus @default(DRAFT)
  validUntil    DateTime?       @map("valid_until") @db.Timestamptz(3)
  notes         String?
  totalAreaSqm  Decimal         @default(0) @map("total_area_sqm") @db.Decimal(14, 3)
  totalAmount   Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy     User            @relation("QuotationsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  items         QuotationItem[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id              Int       @id @default(autoincrement())
  quotationId     Int       @map("quotation_id")
  productId       Int       @map("product_id")
  description     String?   @db.VarChar(240)
  lengthCm        Int       @map("length_cm")
  widthCm         Int       @map("width_cm")
  thicknessCm     Int?      @map("thickness_cm")
  quantity        Int
  areaSqm         Decimal   @map("area_sqm") @db.Decimal(14, 3)
  unitPricePerSqm Decimal   @map("unit_price_per_sqm") @db.Decimal(12, 2)
  lineTotal       Decimal   @map("line_total") @db.Decimal(12, 2)
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model SaleReturn {
  id            Int              @id @default(autoincrement())
