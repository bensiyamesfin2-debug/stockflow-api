generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CASHIER
  INVENTORY_STAFF
}

enum SaleStatus {
  PENDING_RELEASE
  PARTIALLY_RELEASED
  COMPLETED
  CANCELLED
  PARTIALLY_RETURNED
  RETURNED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum InventoryMovementType {
  STOCK_IN
  RELEASE
  RETURN_IN
  DAMAGE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  COMPLETED
  ADJUSTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OwnerExpenseEntryType {
  IN
  OUT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum SaasTenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id                   Int                         @id @default(autoincrement())
  fullName             String                      @map("full_name") @db.VarChar(150)
  username             String                      @unique @db.VarChar(100)
  passwordHash         String                      @map("password_hash")
  role                 UserRole
  isActive             Boolean                     @default(true) @map("is_active")
  failedLoginAttempts  Int                         @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?                   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt          DateTime?                   @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt    DateTime                    @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  tokenVersion         Int                         @default(0) @map("token_version")
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales                Sale[]                      @relation("CashierSales")
  paymentsRecorded     Payment[]                   @relation("RecordedPayments")
  inventoryReleases    InventoryRelease[]          @relation("ReleasedBy")
  stockReceipts        StockReceipt[]              @relation("ReceivedBy")
  inventoryMovements   InventoryMovement[]         @relation("MovementCreatedBy")
  auditLogs            AuditLog[]                  @relation("UserAuditLogs")
  loginPairings        LoginPairing[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  purchaseOrders       PurchaseOrder[]             @relation("PurchaseOrdersCreated")
  stockCountsCreated   StockCount[]                @relation("StockCountsCreated")
  stockCountsCompleted StockCount[]                @relation("StockCountsCompleted")
  stockCountsAdjusted  StockCount[]                @relation("StockCountsAdjusted")
  shifts               Shift[]
  preferences          UserPreference?
  notes                WorkspaceNote[]
  calendarEvents       CalendarEvent[]             @relation("CalendarEventOwner")
  favorites            Favorite[]
  attachments          FileAttachment[]
  ownerExpenseEntries  OwnerExpenseEntry[]
  invoiceTemplates     InvoiceTemplate[]
  deliveryProofs       DeliveryProof[]             @relation("DeliveredBy")
  priceListsCreated    PriceList[]                 @relation("PriceListsCreated")
  stockTransfers       StockTransfer[]             @relation("TransfersCreated")
  quotations           Quotation[]                 @relation("QuotationsCreated")
  saleReturnsProcessed SaleReturn[]                @relation("SaleReturnsProcessed")
  twoFactorSecret      String?                     @map("two_factor_secret") @db.VarChar(128)
  twoFactorEnabled     Boolean                     @default(false) @map("two_factor_enabled")
  isPlatformOwner      Boolean                     @default(false) @map("is_platform_owner")
  tenantsCreated       SaasTenant[]                @relation("SaasTenantCreatedBy")
  subscriptionPayments TenantSubscriptionPayment[] @relation("SubscriptionPaymentsRecorded")

  @@map("users")
}

model SaasTenant {
  id                        String                      @id @default(uuid()) @db.Uuid
  companyName               String                      @map("company_name") @db.VarChar(160)
  companyCode               String                      @unique @map("company_code") @db.VarChar(40)
  slug                      String                      @unique @db.VarChar(80)
  status                    SaasTenantStatus            @default(PROVISIONING)
  plan                      String                      @default("GROWTH") @db.VarChar(24)
  primaryCurrency           String                      @default("ETB") @map("primary_currency") @db.VarChar(3)
  locale                    String                      @default("en") @db.VarChar(10)
  timezone                  String                      @default("Africa/Addis_Ababa") @db.VarChar(64)
  region                    String                      @default("africa-east1") @db.VarChar(48)
  deploymentUrl             String?                     @unique @map("deployment_url") @db.VarChar(500)
  databaseIsolation         String                      @default("DEDICATED_DATABASE") @map("database_isolation") @db.VarChar(32)
  monitoringTokenHash       String?                     @map("monitoring_token_hash") @db.VarChar(64)
  lastHeartbeatAt           DateTime?                   @map("last_heartbeat_at") @db.Timestamptz(3)
  lastHealthStatus          String                      @default("UNKNOWN") @map("last_health_status") @db.VarChar(24)
  lastDatabaseOk            Boolean?                    @map("last_database_ok")
  lastVersion               String?                     @map("last_version") @db.VarChar(80)
  lastUptimeSeconds         Int?                        @map("last_uptime_seconds")
  lastMemoryMb              Int?                        @map("last_memory_mb")
  lastErrorAt               DateTime?                   @map("last_error_at") @db.Timestamptz(3)
  provisioningStatus        String                      @default("NOT_STARTED") @map("provisioning_status") @db.VarChar(32)
  provisioningStep          String?                     @map("provisioning_step") @db.VarChar(80)
  provisioningError         String?                     @map("provisioning_error")
  provider                  String?                     @db.VarChar(32)
  providerDatabaseId        String?                     @unique @map("provider_database_id") @db.VarChar(80)
  providerServiceId         String?                     @unique @map("provider_service_id") @db.VarChar(80)
  providerDeployId          String?                     @map("provider_deploy_id") @db.VarChar(80)
  backendUrl                String?                     @unique @map("backend_url") @db.VarChar(500)
  provisioningStartedAt     DateTime?                   @map("provisioning_started_at") @db.Timestamptz(3)
  provisioningCompletedAt   DateTime?                   @map("provisioning_completed_at") @db.Timestamptz(3)
  monthlyPriceMinor         Int                         @default(1000000) @map("monthly_price_minor")
  subscriptionCurrency      String                      @default("ETB") @map("subscription_currency") @db.VarChar(3)
  subscriptionEndsAt        DateTime?                   @map("subscription_ends_at") @db.Timestamptz(3)
  lastSubscriptionPaymentAt DateTime?                   @map("last_subscription_payment_at") @db.Timestamptz(3)
  subscriptionExempt        Boolean                     @default(false) @map("subscription_exempt")
  notes                     String?
  createdById               Int?                        @map("created_by_id")
  activatedAt               DateTime?                   @map("activated_at") @db.Timestamptz(3)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                 User?                       @relation("SaasTenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  errorAggregates           TenantErrorAggregate[]
  subscriptionPayments      TenantSubscriptionPayment[]

  @@index([status, createdAt])
  @@index([createdById])
  @@map("saas_tenants")
}

model TenantSubscriptionPayment {
  id           Int        @id @default(autoincrement())
  tenantId     String     @map("tenant_id") @db.Uuid
  amountMinor  Int        @map("amount_minor")
  currency     String     @default("ETB") @db.VarChar(3)
  coveredFrom  DateTime   @map("covered_from") @db.Timestamptz(3)
  coveredUntil DateTime   @map("covered_until") @db.Timestamptz(3)
  recordedById Int        @map("recorded_by_id")
  paidAt       DateTime   @default(now()) @map("paid_at") @db.Timestamptz(3)
  tenant       SaasTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedBy   User       @relation("SubscriptionPaymentsRecorded", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, paidAt])
  @@index([paidAt])
  @@map("tenant_subscription_payments")
}

model TenantErrorAggregate {
  id              Int        @id @default(autoincrement())
  tenantId        String     @map("tenant_id") @db.Uuid
  fingerprint     String     @db.VarChar(64)
  errorType       String     @map("error_type") @db.VarChar(120)
  route           String     @db.VarChar(200)
  method          String     @db.VarChar(10)
  statusCode      Int        @map("status_code")
  occurrenceCount Int        @default(1) @map("occurrence_count")
  firstSeenAt     DateTime   @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  resolvedAt      DateTime?  @map("resolved_at") @db.Timestamptz(3)
  tenant          SaasTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fingerprint])
  @@index([resolvedAt, lastSeenAt])
  @@index([tenantId, occurrenceCount])
  @@map("tenant_error_aggregates")
}

model LoginPairing {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("login_pairings")
}

model Product {
  id                 Int                        @id @default(autoincrement())
  sku                String                     @unique @db.VarChar(100)
  name               String                     @db.VarChar(200)
  length             Int?
  width              Int?
  thickness          Int?
  description        String?
  sellingPrice       Decimal                    @map("selling_price") @db.Decimal(12, 2)
  costPrice          Decimal?                   @map("cost_price") @db.Decimal(12, 2)
  categoryId         Int?                       @map("category_id")
  isActive           Boolean                    @default(true) @map("is_active")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventory          Inventory?
  saleItems          SaleItem[]
  stockReceiptItems  StockReceiptItem[]
  inventoryMovements InventoryMovement[]
  category           Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]
  stockCountItems    StockCountItem[]
  locationBalances   InventoryLocationBalance[]
  stockBatches       StockBatch[]
  priceListItems     PriceListItem[]
  transferItems      StockTransferItem[]
  quotationItems     QuotationItem[]

  @@index([categoryId])
  @@map("products")
}

model Inventory {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique @map("product_id")
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderLevel     Int      @default(5) @map("reorder_level")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model Sale {
  id                 Int                @id @default(autoincrement())
  saleNumber         String             @unique @map("sale_number") @db.VarChar(50)
  clientRequestId    String?            @unique @map("client_request_id") @db.Uuid
  cashierId          Int                @map("cashier_id")
  customerId         Int?               @map("customer_id")
  discountId         Int?               @map("discount_id")
  shiftId            Int?               @map("shift_id")
  customerName       String?            @map("customer_name") @db.VarChar(150)
  discountAmount     Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount        Decimal            @map("total_amount") @db.Decimal(12, 2)
  creditBalance      Decimal            @default(0) @map("credit_balance") @db.Decimal(12, 2)
  creditDueAt        DateTime?          @map("credit_due_at") @db.Timestamptz(3)
  status             SaleStatus         @default(PENDING_RELEASE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?            @map("cancellation_reason")
  cashier            User               @relation("CashierSales", fields: [cashierId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]
  releases           InventoryRelease[]
  notifications      Notification[]
  returns            SaleReturn[]
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount           Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  shift              Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  priceList          PriceList?         @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  priceListId        Int?               @map("price_list_id")

  @@index([cashierId])
  @@index([customerId])
  @@index([discountId])
  @@index([shiftId])
  @@index([status, createdAt])
  @@map("sales")
}

model SaleItem {
  id                 Int                    @id @default(autoincrement())
  saleId             Int                    @map("sale_id")
  productId          Int                    @map("product_id")
  quantity           Int
  unitPrice          Decimal                @map("unit_price") @db.Decimal(12, 2)
  costPriceAtSale    Decimal?               @map("cost_price_at_sale") @db.Decimal(12, 2)
  releasedQuantity   Int                    @default(0) @map("released_quantity")
  returnedQuantity   Int                    @default(0) @map("returned_quantity")
  customLength       Int?                   @map("custom_length")
  customWidth        Int?                   @map("custom_width")
  customThickness    Int?                   @map("custom_thickness")
  requestedPieces    Int?                   @map("requested_pieces")
  piecesPerStockUnit Int?                   @map("pieces_per_stock_unit")
  sale               Sale                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  releaseItems       InventoryReleaseItem[]
  returnItems        SaleReturnItem[]

  @@index([saleId, productId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id                   Int           @id @default(autoincrement())
  saleId               Int           @map("sale_id")
  paymentMethod        PaymentMethod @map("payment_method")
  status               PaymentStatus @default(COMPLETED)
  bankName             String?       @map("bank_name") @db.VarChar(150)
  recipientAccount     String?       @map("recipient_account") @db.VarChar(150)
  transactionReference String?       @map("transaction_reference") @db.VarChar(150)
  amount               Decimal       @db.Decimal(12, 2)
  recordedById         Int           @map("recorded_by_id")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  sale                 Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  recordedBy           User          @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([paymentMethod, createdAt])
  @@map("payments")
}

model InventoryRelease {
  id            Int                    @id @default(autoincrement())
  releaseNumber String                 @unique @map("release_number") @db.VarChar(50)
  saleId        Int                    @map("sale_id")
  releasedById  Int                    @map("released_by_id")
  notes         String?
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  sale          Sale                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  releasedBy    User                   @relation("ReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  items         InventoryReleaseItem[]
  deliveryProof DeliveryProof?

  @@index([saleId])
  @@map("inventory_releases")
}

model InventoryReleaseItem {
  id         Int              @id @default(autoincrement())
  releaseId  Int              @map("release_id")
  saleItemId Int              @map("sale_item_id")
  quantity   Int
  release    InventoryRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  saleItem   SaleItem         @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@unique([releaseId, saleItemId])
  @@index([saleItemId])
  @@map("inventory_release_items")
}

model StockReceipt {
  id              Int                @id @default(autoincrement())
  receiptNumber   String             @unique @map("receipt_number") @db.VarChar(50)
  supplierName    String?            @map("supplier_name") @db.VarChar(150)
  supplierId      Int?               @map("supplier_id")
  purchaseOrderId Int?               @map("purchase_order_id")
  referenceNumber String?            @map("reference_number") @db.VarChar(150)
  containerNumber String?            @map("container_number") @db.VarChar(100)
  vehiclePlate    String?            @map("vehicle_plate") @db.VarChar(80)
  qualityStatus   String?            @map("quality_status") @db.VarChar(40)
  inspectionNotes String?            @map("inspection_notes")
  receivedById    Int                @map("received_by_id")
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  receivedBy      User               @relation("ReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  items           StockReceiptItem[]
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  batches         StockBatch[]

  @@index([receivedById, createdAt])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id              Int          @id @default(autoincrement())
  receiptId       Int          @map("receipt_id")
  productId       Int          @map("product_id")
  quantity        Int
  unitCost        Decimal?     @map("unit_cost") @db.Decimal(12, 2)
  damagedQuantity Int          @default(0) @map("damaged_quantity")
  batchId         Int?         @unique @map("batch_id")
  receipt         StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch           StockBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([receiptId, productId])
  @@index([productId])
  @@map("stock_receipt_items")
}

model InventoryMovement {
  id             Int                   @id @default(autoincrement())
  productId      Int                   @map("product_id")
  movementType   InventoryMovementType @map("movement_type")
  quantityChange Int                   @map("quantity_change")
  balanceAfter   Int                   @map("balance_after")
  referenceType  String                @map("reference_type") @db.VarChar(50)
  referenceId    Int?                  @map("reference_id")
  createdById    Int                   @map("created_by_id")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy      User                  @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model OwnerExpenseEntry {
  id              Int                   @id @default(autoincrement())
  entryType       OwnerExpenseEntryType @map("entry_type")
  amount          Decimal               @db.Decimal(12, 2)
  balanceAfter    Decimal               @map("balance_after") @db.Decimal(12, 2)
  note            String?
  transactionDate DateTime              @map("transaction_date") @db.Timestamptz(3)
  createdById     Int                   @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([transactionDate, id])
  @@index([createdById])
  @@map("owner_expense_entries")
}

model InventoryLocation {
  id            Int                        @id @default(autoincrement())
  code          String                     @unique @db.VarChar(80)
  name          String                     @db.VarChar(120)
  warehouse     String?                    @db.VarChar(120)
  rowLabel      String?                    @map("row_label") @db.VarChar(60)
  rack          String?                    @db.VarChar(60)
  slot          String?                    @db.VarChar(60)
  isActive      Boolean                    @default(true) @map("is_active")
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  balances      InventoryLocationBalance[]
  batches       StockBatch[]
  transfersFrom StockTransfer[]            @relation("TransferFrom")
  transfersTo   StockTransfer[]            @relation("TransferTo")
  returnItems   SaleReturnItem[]

  @@map("inventory_locations")
}

model InventoryLocationBalance {
  id         Int               @id @default(autoincrement())
  locationId Int               @map("location_id")
  productId  Int               @map("product_id")
  quantity   Int               @default(0)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([productId])
  @@map("inventory_location_balances")
}

model StockBatch {
  id                Int                 @id @default(autoincrement())
  batchNumber       String              @unique @map("batch_number") @db.VarChar(120)
  productId         Int                 @map("product_id")
  receiptId         Int?                @map("receipt_id")
  supplierId        Int?                @map("supplier_id")
  locationId        Int?                @map("location_id")
  origin            String?             @db.VarChar(120)
  color             String?             @db.VarChar(120)
  grade             String?             @db.VarChar(80)
  originalQuantity  Int                 @map("original_quantity")
  availableQuantity Int                 @map("available_quantity")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  receipt           StockReceipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location          InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  receiptItem       StockReceiptItem?
  transferItems     StockTransferItem[]

  @@index([productId, availableQuantity])
  @@index([locationId])
  @@map("stock_batches")
}

model DeliveryProof {
  id            Int              @id @default(autoincrement())
  releaseId     Int              @unique @map("release_id")
  deliveredById Int              @map("delivered_by_id")
  receiverName  String           @map("receiver_name") @db.VarChar(150)
  receiverPhone String?          @map("receiver_phone") @db.VarChar(40)
  signatureName String?          @map("signature_name") @db.VarChar(150)
  photoName     String?          @map("photo_name") @db.VarChar(180)
  photoMimeType String?          @map("photo_mime_type") @db.VarChar(100)
  photoContent  String?          @map("photo_content")
  notes         String?
  deliveredAt   DateTime         @default(now()) @map("delivered_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  release       InventoryRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  deliveredBy   User             @relation("DeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)

  @@index([deliveredAt])
  @@map("delivery_proofs")
}

model PriceList {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(120)
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  isDefault   Boolean         @default(false) @map("is_default")
  createdById Int             @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
