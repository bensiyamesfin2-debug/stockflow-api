INSTANCE_TIMEZONE=Africa/Addis_Ababa
INSTANCE_REGION=africa-east1
INSTANCE_PLAN=GROWTH
INSTANCE_PUBLIC_URL=https://your-stockflow-workspace.example
INSTANCE_CONTROL_PLANE=true
